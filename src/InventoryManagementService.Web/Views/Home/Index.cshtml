@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card stat-primary shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-ico"><i class="fas fa-building"></i></div>
                <div>
                    <div class="stat-val">@Model.TotalCustomers</div>
                    <div class="stat-lbl">Jami mijozlar</div>
                    <div class="stat-hint"><i class="fas fa-arrow-trend-up me-1"></i>@Model.NewCustomersThisMonth bu oy yangi</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card stat-warning shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-ico"><i class="fas fa-handshake"></i></div>
                <div>
                    <div class="stat-val">@Model.ActiveDeals</div>
                    <div class="stat-lbl">Faol bitimlar</div>
                    <div class="stat-hint"><i class="fas fa-trophy me-1"></i>@Model.DealsWonThisMonth bu oy yutildi</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card stat-success shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-ico"><i class="fas fa-coins"></i></div>
                <div>
                    <div class="stat-val" style="font-size:1.4rem;">@(Model.MonthlyRevenue.ToString("N0"))</div>
                    <div class="stat-lbl">Oylik daromad (so'm)</div>
                    <div class="stat-hint">Jami: @(Model.TotalRevenue.ToString("N0")) so'm</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card stat-info shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-ico"><i class="fas fa-box"></i></div>
                <div>
                    <div class="stat-val">@Model.TotalProducts</div>
                    <div class="stat-lbl">Faol mahsulotlar</div>
                    <div class="stat-hint"><i class="fas fa-layer-group me-1"></i>Katalogda mavjud</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="card-icon"><i class="fas fa-handshake"></i></div>
                    So'nggi bitimlar
                </div>
                <a asp-controller="Deals" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    Barchasi <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Bitim nomi</th>
                            <th>Mijoz</th>
                            <th>Holat</th>
                            <th class="text-end pe-4">Summa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.RecentDeals)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-controller="Deals" asp-action="Details" asp-route-id="@d.Id"
                                       class="text-decoration-none fw-semibold" style="color:#0f172a;">@d.Title</a>
                                </td>
                                <td><span style="color:#64748b;font-size:0.875rem;">@d.CustomerName</span></td>
                                <td>
                                    <span class="badge bg-@(WholesaleCRM.Application.EnumHelper.GetDealStatusBadge(d.StatusValue))">
                                        @d.Status
                                    </span>
                                </td>
                                <td class="fw-semibold text-end pe-4" style="color:#0f172a;">@(d.TotalAmount.ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="card-icon"><i class="fas fa-clock-rotate-left"></i></div>
                    So'nggi faoliyatlar
                </div>
                <a asp-controller="Activities" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    Barchasi <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body" style="max-height:380px;overflow-y:auto;">
                @foreach (var a in Model.RecentActivities)
                {
                    <div class="activity-item">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas @a.TypeIcon mt-1" style="color:#6366f1;font-size:0.85rem;"></i>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small" style="color:#0f172a;">@a.Subject</div>
                                @if (!string.IsNullOrEmpty(a.CustomerName))
                                {
                                    <div style="color:#64748b;font-size:0.78rem;">@a.CustomerName</div>
                                }
                                <div style="color:#94a3b8;font-size:0.74rem;">@a.ActivityDate.ToString("dd.MM.yyyy")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.DealsByStatus.Any())
{
    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-icon"><i class="fas fa-chart-bar"></i></div>
                    Bitimlar holat bo'yicha
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var kv in Model.DealsByStatus)
                        {
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="text-center p-3 rounded-3" style="background:#f8fafc;border:1px solid #e2e8f0;">
                                    <div class="fw-bold mb-1" style="font-size:1.75rem;color:#6366f1;letter-spacing:-1px;">@kv.Value</div>
                                    <div class="small" style="color:#64748b;font-size:0.78rem;font-weight:500;">@kv.Key</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
