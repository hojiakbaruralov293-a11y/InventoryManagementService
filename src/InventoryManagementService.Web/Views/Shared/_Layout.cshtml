<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — LexusCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="sidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <i class="fas fa-bolt"></i>
            </div>
            <div class="brand-text">
                <span class="brand-name">LexusCRM</span>
                <span class="brand-tag">Wholesale Platform</span>
            </div>
        </a>

        <nav class="sidebar-nav">
            <p class="nav-section-label">Asosiy</p>
            <ul class="nav flex-column gap-0">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <span class="nav-ico"><i class="fas fa-chart-pie"></i></span>
                        Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Customers" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")">
                        <span class="nav-ico"><i class="fas fa-building"></i></span>
                        Mijozlar
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Contacts" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contacts" ? "active" : "")">
                        <span class="nav-ico"><i class="fas fa-address-book"></i></span>
                        Kontaktlar
                    </a>
                </li>
            </ul>

            <p class="nav-section-label">Savdo</p>
            <ul class="nav flex-column gap-0">
                <li class="nav-item">
                    <a asp-controller="Deals" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Deals" ? "active" : "")">
                        <span class="nav-ico"><i class="fas fa-handshake"></i></span>
                        Bitimlar
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Products" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                        <span class="nav-ico"><i class="fas fa-box"></i></span>
                        Mahsulotlar
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Activities" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")">
                        <span class="nav-ico"><i class="fas fa-clock-rotate-left"></i></span>
                        Faoliyatlar
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <div class="user-block">
                <div class="user-avatar">
                    @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="user-name text-truncate">@User.Identity?.Name</div>
                    <div class="user-role">Foydalanuvchi</div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn btn-outline-secondary w-100 d-flex align-items-center gap-2 justify-content-center py-2">
                    <i class="fas fa-right-from-bracket"></i>
                    <span>Chiqish</span>
                </button>
            </form>
        </div>
    </div>

    <div class="main-wrapper">
        <div class="topbar">
            <div class="topbar-left">
                <div class="topbar-title">@ViewData["Title"]</div>
            </div>
            <div class="topbar-actions">
                <a asp-controller="Activities" asp-action="Create" class="topbar-btn" title="Faoliyat qo'shish">
                    <i class="fas fa-clock-rotate-left"></i>
                </a>
                <a asp-controller="Customers" asp-action="Create" class="topbar-btn" title="Mijoz qo'shish">
                    <i class="fas fa-user-plus"></i>
                </a>
                <a asp-controller="Deals" asp-action="Create" class="btn btn-primary btn-sm px-3" style="height:38px;display:flex;align-items:center;gap:6px;">
                    <i class="fas fa-plus"></i>
                    <span>Yangi bitim</span>
                </a>
            </div>
        </div>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-circle-check me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
